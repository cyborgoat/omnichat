{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "omnichat",
  "version": "1.1.4",
  "identifier": "com.omnichat.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI_BUILD=true npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Omnichat",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
